# Admin CMS
# Password za /admin panel
ADMIN_PASSWORD=promijeni_ovo_odmah
# Tajni ključ za generisanje tokena (bilo koji random string)
ADMIN_SECRET=neki_random_secret_string

# Vercel KV (Upstash Redis) - za produkciju
# Dobijas automatski iz: Vercel Dashboard > Storage > KV > Connect to project
# Ako ove varijable NISU postavljene, koristi se lokalni filesystem (/data/*.json)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Email - koristis Resend (https://resend.com - free tier 3000 emailova/mj)
# 1. Registruj se na resend.com
# 2. Dodaj API key ovdje
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email na koji dolaze kontakt poruke
CONTACT_EMAIL=info@mma-ibk.at

# Ili ako koristis SMTP (npr. Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tvojemail@gmail.com
# SMTP_PASS=app_password_ovdje
